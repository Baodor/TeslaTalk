# Generate real secrets with: python3 scripts/configure.py
APP_URL=https://talk.example.com
APP_HOST=talk.example.com
# Optional: exact name of an existing Traefik ACME resolver, e.g. letsencrypt.
# Leave empty if Traefik already supplies the correct certificate.
TRAEFIK_CERT_RESOLVER=
APP_TIMEZONE=Europe/Berlin
APP_SECRET=
DEMO_MODE=false
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_FLEET_URL=https://fleet-api.prd.eu.vn.cloud.tesla.com
FLEET_POLL_INTERVAL=120
LIVEKIT_URL=wss://voice.example.com
VOICE_HOST=voice.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# CGNAT/WireGuard: public IPv4 of the VPS forwarding 7881/TCP and 7882/UDP.
# Apply with python3 scripts/configure_voice.py, then recreate LiveKit.
LIVEKIT_PUBLIC_IP=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Optional: separate administrator login. Drivers use Tesla OAuth instead.
# Create a confidential OIDC client with the authorization-code flow.
# Redirect URI: <APP_URL>/auth/admin/callback
# OIDC_ISSUER is the discovery document's issuer value, without
# /.well-known/openid-configuration. Do not use the login/authorization URL.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Pocket ID: client_secret_post. Other providers may use client_secret_basic.
OIDC_TOKEN_AUTH_METHOD=client_secret_basic
# Space-separated scopes; add groups when your provider requires that scope.
# Pocket ID / Authelia: use openid email profile groups
OIDC_SCOPES=openid email profile
# Claim containing group names; nested paths such as realm_access.roles work too.
OIDC_GROUPS_CLAIM=groups
# Grant admin access via this group in the configured ID-token/UserInfo claim,
# OR list allowed email addresses below (comma-separated; email_verified=true).
ADMIN_GROUP=teslatalk-admin
ADMIN_EMAILS=
